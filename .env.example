# ==============================================================================
# VADEAUDIO AI - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# NUNCA COMMITAR VALORES REAIS NESTE ARQUIVO.
# ==============================================================================

# Configurações do Servidor
PORT=8080
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:8080,https://app.vadeaudio.com.br

# Segurança & Sessões Criptográficas
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_32_chars_long
WEBHOOK_SECRET=your_payment_gateway_webhook_hmac_secret_key

# ElevenLabs Neural Text-to-Speech API
# Chave mantida EXCLUSIVAMENTE no servidor backend
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE_ID=xHUwLsLfyqiYOIVTzLRW

# Banco de Dados & Armazenamento Privado
DATABASE_URL=postgresql://vade_user:vade_password@127.0.0.1:5432/vadeaudio_prod
STORAGE_DRIVER=local

# Limites de Taxa (Rate Limiting)
RATE_LIMIT_MAX_AUTH=15
RATE_LIMIT_MAX_TTS=35
RATE_LIMIT_MAX_AI=45
